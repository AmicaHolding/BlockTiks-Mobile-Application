{
  "expo": {
    "name": "BlockTiks",
    "slug": "blocktiks-expo-go",
    "version": "1.0.10",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "blocktiks",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.amicaholding.blocktiks",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Allow BlockTiks to access your camera to scan tickets and upload event photos.",
        "NSPhotoLibraryUsageDescription": "Allow BlockTiks to access your photos to upload event images.",
        "NSMicrophoneUsageDescription": "Allow BlockTiks to access your microphone for video capture."
      }
    },
    "android": {
      "package": "com.amicaholding.blocktiks",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B0B0F"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow BlockTiks to access your camera to scan tickets and upload event photos.",
          "microphonePermission": "Allow BlockTiks to access your microphone for video capture.",
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow BlockTiks to access your photos to upload event images.",
          "cameraPermission": "Allow BlockTiks to access your camera to upload event photos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0B0B0F"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
