# Copy to .env.deploy.dev / .env.deploy.staging / .env.deploy.prod (gitignored)
# and fill in. Read by scripts/deploy.sh.

# openssl rand -hex 32, use a different value per stage
JWT_SECRET=
# sk_test_... for dev/staging, sk_live_... for prod
STRIPE_SECRET_KEY=
# Signing secret of the Stripe webhook pointing at <ApiUrl>/webhooks/stripe.
# Optional on the first dev/staging deploy (you only get ApiUrl afterwards).
STRIPE_WEBHOOK_SECRET=
# Comma-separated web origins (Studio + buyer web). Never * in prod.
ALLOWED_ORIGINS=*
