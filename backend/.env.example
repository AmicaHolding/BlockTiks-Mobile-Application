# Server
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed origins (use * for local dev only)
CORS_ORIGIN=*

# AWS
AWS_REGION=us-east-1
TABLE_NAME=blocktiks
# Only for DynamoDB Local — leave unset on Lambda/real AWS
# DYNAMODB_ENDPOINT=http://localhost:8000

# Auth — generate with: openssl rand -hex 32
JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRES_IN=7d

# Stripe — use TEST mode keys (sk_test_...) until go-live
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_KEY
# From `stripe listen` locally, or the API Gateway webhook URL in prod
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Platform fee added on top of ticket face value (matches the app's 12%)
PLATFORM_FEE_PERCENT=12

# Minutes a PENDING order holds ticket inventory before the sweeper releases it
RESERVATION_TTL_MINUTES=15
