{
  "name": "blocktiks-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Sahra (BlockTiks) backend — auth, events, ticketing, Stripe payments on Cloudflare Workers + D1 (SQLite)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "build:lambda": "esbuild src/lambda.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/lambda.js --external:@aws-sdk/*",
    "build:sweeper": "esbuild src/sweeper.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/sweeper.js --external:@aws-sdk/*",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc -p scripts",
    "stripe:listen": "stripe listen --forward-to localhost:4000/webhooks/stripe",
    "db:up": "tsx scripts/create-table.ts",
    "db:down": "echo \"SQLite file db: delete backend/data/dev.db to reset\"",
    "db:create": "tsx scripts/create-table.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/seed.ts --reset",
    "db:more": "tsx scripts/seed.ts --more",
    "dev:local": "tsx watch src/index.ts",
    "db:seed:remote": "wrangler d1 execute sahra-db --remote --file schema.sql",
    "dev:worker": "wrangler dev",
    "deploy:worker": "wrangler deploy"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/lib-dynamodb": "^3.0.0",
    "@fastify/aws-lambda": "^6.0.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^11.2.2",
    "better-sqlite3": "^11.10.0",
    "fastify": "^5.6.0",
    "fastify-plugin": "^5.0.0",
    "stripe": "^18.5.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.2",
    "wrangler": "^4.165.0"
  }
}
