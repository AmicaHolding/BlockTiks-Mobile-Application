{
  "name": "blocktiks-backend",
  "version": "0.1.0",
  "private": true,
  "description": "BlockTiks MVP backend — auth, events, ticketing, Stripe payments on Lambda + DynamoDB",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "build:lambda": "esbuild src/lambda.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/lambda.js --external:@aws-sdk/*",
    "build:sweeper": "esbuild src/sweeper.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/sweeper.js --external:@aws-sdk/*",
    "typecheck": "tsc --noEmit",
    "stripe:listen": "stripe listen --forward-to localhost:4000/webhooks/stripe"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/lib-dynamodb": "^3.0.0",
    "@fastify/aws-lambda": "^6.0.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/jwt": "^10.0.0",
    "fastify": "^5.6.0",
    "fastify-plugin": "^5.0.0",
    "stripe": "^18.5.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.2"
  }
}
